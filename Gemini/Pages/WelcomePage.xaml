<phone:PhoneApplicationPage
    x:Class="GeminiWP81.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    SupportedOrientations="Portrait" Orientation="Portrait">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,17,12,20">
            <TextBlock Text="GEMINI" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="WelcomeTitle" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
            <TextBlock x:Name="WelcomeInstructions" Margin="9,8,12,0" TextWrapping="Wrap" Style="{StaticResource PhoneTextNormalStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,12">
            <StackPanel>
                <TextBlock x:Name="LanguageLabel" Style="{StaticResource PhoneTextGroupHeaderStyle}" Margin="0,0,0,5"/>
                <RadioButton x:Name="EnglishLanguageOption" Content="English" GroupName="AppLanguage" Checked="LanguageOption_Checked"/>
                <RadioButton x:Name="SpanishLanguageOption" Content="Español" GroupName="AppLanguage" Checked="LanguageOption_Checked"/>

                <TextBlock x:Name="ApiKeyLabel" Style="{StaticResource PhoneTextGroupHeaderStyle}" Margin="0,16,0,5"/>
                <TextBox x:Name="ApiKeyInput"/>
                <HyperlinkButton x:Name="ApiKeyHelpLink" Click="ApiKeyHelpLink_Click" HorizontalAlignment="Left" Padding="0" Margin="0,-8,0,8"/>

                <Button x:Name="ContinueButton" Click="ContinueButton_Click" HorizontalAlignment="Right" Width="240" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>